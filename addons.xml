<?xml version="1.0" encoding="UTF-8"?>
<addons>
<!-- Generated by tools/build_repo.py; edit REPO_URL / REPOSITORY_VERSION there instead. -->
<addon id="repository.unknown" name="Unknown Repository" version="1.0.0" provider-name="unknown">
	<extension point="xbmc.addon.repository" name="Unknown Repository">
		<dir>
			<info compressed="false">https://xxscrimxx.github.io/Kodi-Netflix/addons.xml</info>
			<checksum>https://xxscrimxx.github.io/Kodi-Netflix/addons.xml.md5</checksum>
			<datadir zip="true">https://xxscrimxx.github.io/Kodi-Netflix/</datadir>
		</dir>
	</extension>
	<extension point="xbmc.addon.metadata">
		<platform>all</platform>
		<summary lang="en_GB">Updates for the Unknown skin and add-ons.</summary>
		<description lang="en_GB">Automatic updates delivered through GitHub Pages - nothing to configure, no home network required.</description>
	</extension>
</addon>
<addon id="skin.unknown" version="1.0.1" name="Unknown" provider-name="unknown">
	<requires>
		<import addon="xbmc.gui" version="5.16.0"/>
	</requires>
	<extension point="xbmc.gui.skin" debugging="false">
		<res width="1920" height="1440" aspect="4:3" default="false" folder="xml" />
		<res width="1920" height="1280" aspect="3:2" default="false" folder="xml" />
		<res width="1920" height="1200" aspect="16:10" default="false" folder="xml" />
		<res width="2040" height="1080" aspect="17:9" default="false" folder="xml" />
		<res width="1920" height="1080" aspect="16:9" default="true" folder="xml" />
		<res width="2560" height="1080" aspect="21:9" default="false" folder="xml" />
		<res width="2338" height="1080" aspect="19.5:9" default="false" folder="xml" />
		<res width="2160" height="1080" aspect="18:9" default="false" folder="xml" />
	</extension>
	<extension point="xbmc.addon.metadata">
		<platform>all</platform>
		<!-- Forked from Estuary by phil65 and Piers; its licenses carry over to this skin. -->
		<license>CC BY-SA 4.0, GNU GENERAL PUBLIC LICENSE Version 2.0</license>
		<assets>
			<icon>resources/icon.png</icon>
			<fanart>resources/fanart.jpg</fanart>
		</assets>
		<summary lang="en_GB">Unknown: a poster-wall skin for Kodi, based on Estuary.</summary>
		<description lang="en_GB">A Netflix-style home screen with a featured banner and poster rows, built on Estuary by phil65 and Piers. Pairs with the Unknown Widgets service.</description>
	</extension>
</addon>
<addon id="service.unknown.widgets" version="1.0.0" name="Unknown Widgets" provider-name="unknown">
	<requires>
		<import addon="xbmc.python" version="3.0.1"/>
	</requires>
	<!-- Keeps widget rows fresh and rotates the featured banner. -->
	<extension point="xbmc.service" library="service.py" start="login"/>
	<!-- Serves the widget rows: plugin://service.unknown.widgets/?list=continue|recent|random|featured -->
	<extension point="xbmc.python.pluginsource" library="plugin.py">
		<provides>video</provides>
	</extension>
	<extension point="xbmc.addon.metadata">
		<platform>all</platform>
		<license>GPL-2.0-or-later</license>
		<summary lang="en_GB">Home screen widgets for the Unknown skin.</summary>
		<description lang="en_GB">Provides Continue Watching, Recently Added, Random Picks and a rotating featured banner from your video library.</description>
	</extension>
</addon>
<addon id="plugin.video.unknown.debrid" version="1.7.0" name="Unknown Debrid" provider-name="unknown">
	<requires>
		<import addon="xbmc.python" version="3.0.1"/>
	</requires>
	<extension point="xbmc.python.pluginsource" library="plugin.py">
		<provides>video</provides>
	</extension>
	<extension point="xbmc.service" library="service.py" start="login"/>
	<extension point="xbmc.addon.metadata">
		<platform>all</platform>
		<license>GPL-2.0-or-later</license>
		<summary lang="en_GB">Real-Debrid library for the Unknown skin.</summary>
		<description lang="en_GB">Mirrors your Real-Debrid torrents into Kodi's video library as streamable entries. Movies and episodes appear on the Unknown home screen with artwork, watched status and resume points, and stream directly from Real-Debrid on playback.</description>
	</extension>
</addon>
</addons>
